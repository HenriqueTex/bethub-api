TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=docker
DB_DATABASE=bethub

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
FOOTBALL_DATA_TOKEN=

# Endereço do front usado nos links dos e-mails (sem barra no final)
WEB_URL=http://localhost:3000

# SMTP da Hostinger: 465 (SSL) ou 587 (STARTTLS).
# SMTP_USER é a caixa que autentica e precisa ser a mesma de MAIL_FROM.
# Deixe SMTP_PASS vazio aqui; preencha só no .env local e no painel da hospedagem.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=nao-responder@texasbethub.com
SMTP_PASS=
MAIL_FROM="Texas Bethub <nao-responder@texasbethub.com>"
MAIL_REPLY_TO=suporte@texasbethub.com
ADMIN_NOTIFY_EMAIL=admin@texasbethub.com
